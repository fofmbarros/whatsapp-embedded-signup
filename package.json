{
  "name": "@fofmbarros/whatsapp-embedded-signup",
  "version": "0.1.0",
  "description": "React component for Meta WhatsApp Embedded Signup",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/fofmbarros/whatsapp-embedded-signup#readme",
  "bugs": {
    "url": "https://github.com/fofmbarros/whatsapp-embedded-signup/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fofmbarros/whatsapp-embedded-signup.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun scripts/build.ts && tsc -p tsconfig.build.json",
    "lint": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint-staged": "lint-staged",
    "typecheck": "tsc --noEmit && tsc -p example/tsconfig.json --noEmit",
    "test": "bun test tests",
    "test:package": "bun pm pack --filename package.tgz && bun scripts/smoke-package.ts package.tgz",
    "release": "bumpp --commit --push --tag",
    "example": "bun run build && bun run --cwd example dev",
    "prepack": "bun run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --deny-warnings --no-error-on-unmatched-pattern",
      "oxfmt --write --no-error-on-unmatched-pattern"
    ],
    "!(*.js|*.jsx|*.ts|*.tsx|*.mjs|*.cjs|*.mts|*.cts)": "oxfmt --write --no-error-on-unmatched-pattern"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bumpp": "^12.3.0",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
